# PostgreSQL (Supabase Postgres or any Postgres 14+). Server-only — never expose in frontend code.
DATABASE_URL=
# Public origin used in email links, e.g. https://performance.epms-pac.com
APP_BASE_URL=
# Email notifications (Resend)
RESEND_API_KEY=
MAIL_FROM=
# Reminder sweep authorization (Vercel Cron sends: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Google Calendar (service account with domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_IMPERSONATE_USER=
# EPMS single sign-on shared secret (HMAC-SHA256)
EPMS_SSO_SECRET=
# One-time bootstrap of the System Owner account (scripts/seed.mjs)
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
# Account that receives the initial action plans for distribution
ABDULLAH_QADI_EMAIL=
